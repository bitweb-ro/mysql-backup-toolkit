# App authentication
APP_USER=admin
APP_PASSWORD=secret
JWT_SECRET=change-this-to-a-random-secret-string

# MySQL container local — folosit doar daca pornesti serviciul "mysql" cu
# --profile local-mysql (server de test). Nu e necesar pentru backup-uirea
# serverelor MySQL externe.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=testdb
MYSQL_USER=backupuser
MYSQL_PASSWORD=backuppassword

# Porturi expuse pe host — schimba-le daca sunt deja ocupate de alt serviciu
PORT_APP_FRONTEND=3000
PORT_APP_BACKEND=3001
PORT_APP_MYSQL=3306

# Folder de pe host unde se salvează fișierele de backup (poate fi orice cale,
# ex. /mnt/backup-disk, util cand discul local nu are spatiu suficient)
BACKUP_PATH=./backup_servers
