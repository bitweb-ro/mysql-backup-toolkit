# Valabil pe MySQL 8.0, 8.4 și 9.x. binlog_format nu se mai setează (deprecated; ROW e implicit),
# iar retenția folosește binlog_expire_logs_seconds (expire_logs_days a fost eliminat în 8.4).
[mysqld]
log_bin            = mysql-bin
server_id          = 1
gtid_mode          = ON
enforce_gtid_consistency = ON
binlog_expire_logs_seconds = 604800
max_binlog_size    = 100M
